# Copy to .env. Everything here is optional: provider, model and keys can also be
# set from the Settings dialog in the app (saved to data/settings.json).

# Server
# RP_PORT=8787
# RP_HOST=127.0.0.1
# RP_DATA_DIR=./data

# The shortest set-up: paste one official key and start the app.
#   ANTHROPIC_API_KEY alone  -> Claude runs the game (claude-opus-5-5).
#   OPENAI_API_KEY alone     -> OpenAI runs the game (gpt-6.1-sol).
#   Both                     -> Claude runs the game; switch illustrations on in
#                               Settings and OpenAI paints it.
#   Neither                  -> demo mode with a scripted game master.

# Which game master to use: anthropic | openai-compatible | mock
# RP_PROVIDER=anthropic

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=

# OpenAI, or any endpoint that speaks its format (DeepSeek, OpenRouter, Ollama, ...).
# The key is only ever sent to OPENAI_BASE_URL (default: OpenAI itself).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6.1-sol

# Illustrations (OpenAI Images API). Uses OPENAI_API_KEY; enable them in Settings.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
