# Copy to .env. Everything here is optional: connections, models and keys can
# also be set from the Settings dialog in the app (saved to data/settings.json),
# and what is saved there takes precedence.

# Server
# RP_PORT=8787
# RP_HOST=127.0.0.1
# RP_DATA_DIR=./data

# The shortest set-up: paste one key and start the app. The first connection
# that has a key runs the game, in this order: Claude, OpenAI, Gemini, custom.
# With none, the app starts in demo mode with a scripted game master.
#
# Which provider tells the story: anthropic | openai | gemini | custom | mock
# RP_PROVIDER=anthropic

# Claude (Anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=

# OpenAI (Responses API)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (through Google's OpenAI-compatible endpoint)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Custom API: any service that speaks OpenAI Chat Completions, such as a
# company gateway, DeepSeek, OpenRouter or a local Ollama.
# RP_CUSTOM_BASE_URL=https://your-gateway.example/v1
# RP_CUSTOM_API_KEY=
# RP_CUSTOM_MODEL=

# A key is only ever sent to the endpoint it is configured with here. It is
# never sent to a different base URL typed into the app.

# Illustrations (OpenAI Images API). Uses the OpenAI key; enable them in Settings.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
